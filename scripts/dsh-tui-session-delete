#!/usr/bin/env python3
"""Enable the existing DSH session deletion flow in dsh-TUI 0.18.0."""

import argparse
import json
import os
from pathlib import Path
import sys

VERSION = '0.18.0'
BACKUP = '.superagent-session-delete-backup.json'
PATCHES = {
    'lib/types/screens/SessionSupervisor.js': [
        ("if (!dshBackend && isMod(key) && input === 'd') {",
         "if (isMod(key) && input === 'd') {"),
    ],
    'lib/types/screens/sessionSupervisor/useSessionSupervisor.js': [
        ("const deleteSession = useCallback((session) => {\n",
         "const deleteSession = useCallback((session) => {\n"
         "        if (dshBackend && liveStateOf(session.id)?.live === true) {\n"
         "            report(t('supervisor-delete-live'), 'error');\n"
         "            return;\n"
         "        }\n"),
        ('}, [archiveSessions, channel, holderOf, liveStateOf, reload, report]);',
         '}, [dshBackend, archiveSessions, channel, holderOf, liveStateOf, reload, report]);'),
    ],
    'lib/types/i18n.js': [
        ('Ctrl+N new · Ctrl+X stop · Esc back',
         'Ctrl+N new · Ctrl+X stop · Ctrl+D delete · Esc back'),
        ('Ctrl+N 新建 · Ctrl+X 停止 · Esc 返回',
         'Ctrl+N 新建 · Ctrl+X 停止 · Ctrl+D 删除 · Esc 返回'),
        ("    'supervisor-delete-current':",
         "    'supervisor-delete-live': { zh: '请先切换到其他会话，再用 Ctrl+X 停止此会话，然后删除', "
         "en: 'Switch to another session, then use Ctrl+X to stop this session before deleting it' },\n"
         "    'supervisor-delete-current':"),
    ],
}


def patched(relative, source):
    """Require every expected edit exactly once, refusing an unfamiliar build."""
    for before, after in PATCHES[relative]:
        if source.count(before) != 1:
            raise ValueError(f'Unsupported TUI build: expected one match in {relative}: {before!r}')
        source = source.replace(before, after, 1)
    return source


def replace(path, text):
    """Publish a complete file, preserving its permissions."""
    temporary = path.with_name(path.name + '.superagent-tmp')
    with temporary.open('x') as stream:
        stream.write(text)
    try:
        temporary.chmod(path.stat().st_mode)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def run(root, restore=False):
    root = root.resolve()
    package = json.loads((root / 'package.json').read_text())
    if package.get('name') != '@deepseek-harness-tui/dsh-tui' or package.get('version') != VERSION:
        raise ValueError(f'Only @deepseek-harness-tui/dsh-tui {VERSION} is supported')
    backup = root / BACKUP
    if backup.exists():
        saved = json.loads(backup.read_text())
        # Do not overwrite files changed by an update or a separate local patch.
        for relative in PATCHES:
            original = saved[relative]['original']
            current = (root / relative).read_text()
            if current not in (original, patched(relative, original)):
                raise ValueError(f'{relative} changed since installation; refusing to overwrite it')
        targets = {relative: saved[relative]['original'] if restore
                   else patched(relative, saved[relative]['original']) for relative in PATCHES}
    elif restore:
        raise ValueError('No backup found; nothing to restore')
    else:
        originals = {relative: (root / relative).read_text() for relative in PATCHES}
        # Validate ALL files before changing any file.
        targets = {relative: patched(relative, original) for relative, original in originals.items()}
        with backup.open('x') as stream:
            json.dump({relative: {'original': original} for relative, original in originals.items()}, stream)
    for relative, target in targets.items():
        replace(root / relative, target)
    if restore:
        backup.unlink()
    print(('Restored' if restore else 'Enabled') + f' DSH session deletion in {root}')
    print('Restart the TUI to load the change.')


def main():
    home = Path(os.environ.get('DSH_HOME', Path.home() / '.dsh'))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--package-dir', type=Path,
                        default=home / 'profiles/tui/node_modules/@deepseek-harness-tui/dsh-tui',
                        help='Installed dsh-TUI package directory (default: the tui profile under DSH_HOME)')
    parser.add_argument('--restore', action='store_true', help='Restore the backed-up original files')
    args = parser.parse_args()
    try:
        run(args.package_dir, args.restore)
    except (OSError, ValueError, KeyError) as error:
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
